  "steps": [
    { "text": "Jablka oloupej, zbav jádřinců a nakrájej na plátky.", "minutes": 7 },
    { "text": "Vymaž pekáč tukem a rozlož do něj jablka.", "minutes": 2 },
    { "text": "Smíchej cukr, mouku, sůl, skořici a muškátový oříšek, posyp jím jablka a lehce promíchej, aby se mouka navlhla.", "minutes": 2 },
    { "text": "Smíchej mouku, prášek do pečiva, jedlou sodu, sůl, ovesné vločky, hnědý cukr a změkčené máslo a promíchej jen do spojení.", "minutes": 2 },
    { "text": "Směsí rovnoměrně posyp jablka." },
    { "text": "Peč v troubě na horkovzduch při 175 °C asi 30 minut, dokud vršek lehce nezhnědne.", "minutes": 30 },
